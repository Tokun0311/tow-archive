---
import '../styles/global.css';
const { title = 'Tow Deng — An Ongoing Archive', description = 'Writing, photography, and research by Tow Deng.' } = Astro.props;
const path = Astro.url.pathname;
const links = [['/','Index'],['/writing/','Writing'],['/photography/','Photography'],['/archive/','Archive'],['/about/','About']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><title>{title}</title></head><body><div class="frame"><header class="mast"><a class="brand" href="/">TOW DENG<small>INDEPENDENT ARCHIVE / EST. 2026</small></a><nav class="nav" aria-label="Main navigation">{links.map(([href,label])=><a href={href} aria-current={path===href?'page':undefined}>{label}</a>)}</nav></header><main><slot/></main><footer class="footer"><span>© {new Date().getFullYear()} Tow Deng · An ongoing archive</span><span>Research / Writing / Photography</span></footer></div></body></html>
