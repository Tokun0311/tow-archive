---
import Base from '../layouts/Base.astro';
import {getCollection} from 'astro:content';
const w=(await getCollection('entries',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const p=(await getCollection('photographs',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const all=[...w.map(x=>({id:x.id,...x.data,url:`/writing/${x.id}/`,kind:'Writing'})),...p.map(x=>({id:x.id,...x.data,url:`/photography/${x.id}/`,kind:'Photography'}))].sort((a,b)=>b.date.valueOf()-a.date.valueOf());
---
<Base><section class="hero"><div class="eyebrow">Index / 001 — A personal collection in progress</div><h1>Notes on art,<br/>images, and the spaces in between.</h1><p>An evolving archive of writing, photography and research. A place to trace encounters, revisit questions, and let unfinished ideas accumulate.</p></section><section class="stack"><div class="section-head"><h2>Recent entries</h2><span>{String(all.length).padStart(2,'0')} records</span></div><ul class="entries">{all.map((e,i)=><li class="entry"><span class="date">{e.date.toISOString().slice(0,10)}</span><a href={e.url}>{e.title}</a><span class="meta">{e.kind} / {'language' in e ? e.language : 'Images'}</span><span class="no">{String(i+1).padStart(2,'0')}</span></li>)}</ul><p class="note">The first entries are demonstration content. Replace them with your own work before publishing.</p></section><section class="stack"><div class="section-head"><h2>Browse the collection</h2><span>Paths into the archive</span></div><div class="index-grid"><a class="index-card" href="/writing/"><span>01 / Texts</span><strong>Writing ↗</strong></a><a class="index-card" href="/photography/"><span>02 / Images</span><strong>Photography ↗</strong></a><a class="index-card" href="/archive/"><span>03 / Records</span><strong>Archive ↗</strong></a></div></section></Base>
