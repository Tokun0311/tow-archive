---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const entries=(await getCollection('entries',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Writing — Tow Deng"><div class="eyebrow" style="margin-top:42px">Collection / 01</div><h1 class="page-title">Writing.</h1><p class="intro">Essays, exhibition reflections, research fragments and notes. Different forms for thinking through art and its histories.</p><ul class="entries">{entries.map((e,i)=><li class="entry"><span class="date">{e.data.date.toISOString().slice(0,10)}</span><a href={`/writing/${e.id}/`}>{e.data.title}</a><span class="meta">{e.data.type} / {e.data.language}</span><span class="no">{String(i+1).padStart(2,'0')}</span></li>)}</ul></Base>
