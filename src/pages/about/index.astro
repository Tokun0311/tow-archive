---
import Base from '../../layouts/Base.astro';
---
<Base title="About | TOW ARCHIVE">
  <section class="about-simple" aria-labelledby="about-heading">
    <h1 id="about-heading">About</h1>
    <p><strong>Lichuan Tow Deng</strong></p>
    <p>An independent archive of writing, research and photography, with a particular interest in exhibitions, art histories, and the ways cultural and political narratives are formed.</p>
    <div class="about-details">
      <p>Writing · Research · Photography</p>
    </div>
  </section>
</Base>
<style>
  .about-simple { max-width:720px; padding:57px 0 80px; min-height:65vh; }
  .about-simple h1 { font-size:clamp(30px,4vw,46px); font-weight:500; margin:0 0 42px; letter-spacing:-.035em; }
  .about-simple p { font-size:16px; line-height:1.85; margin:0 0 20px; }
  .about-simple strong { font-weight:600; }
  .about-details { margin-top:46px; border-top:1px solid var(--rule); padding-top:20px; }
  .about-details p { font-size:13px; color:var(--quiet); }
</style>
