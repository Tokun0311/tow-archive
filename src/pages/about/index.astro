---
import Base from '../../layouts/Base.astro';
---
<Base title="About | TOW ARCHIVE">
  <section class="about-simple" aria-labelledby="about-heading">
    <h1 id="about-heading">About</h1>
    <p>TOW ARCHIVE is a personal archive of observations, research, and reflections, created and curated by Lichuan (Tow) Deng.</p>
    <p>Rooted in lived experience and a belief in the possibilities of contemporary art, this archive is an ongoing attempt to understand the world around me, to question how meaning is produced, and to explore how I might engage with and contribute to it.</p>
    <p>The archive moves between Chinese, Japanese, and English, guided by my intuition.</p>
  </section>
</Base>
<style>
  .about-simple { max-width:720px; padding:56px 0 80px; min-height:65vh; }
  .about-simple h1 { font-size:clamp(30px,4vw,46px); font-weight:500; margin:0 0 42px; letter-spacing:-.035em; }
  .about-simple p { font-size:16px; line-height:1.85; margin:0 0 22px; }
</style>
