---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('institutions')).map(item=>({params:{slug:item.id},props:{item}}));}
const {item}=Astro.props;
const {Content}=await render(item);
const exhibitions=(await getCollection('exhibitions')).filter(e=>e.data.institution===item.id).sort((a,b)=>b.data.visitedOn.valueOf()-a.data.visitedOn.valueOf());
---
<Base title={`${item.data.name} | TOW ARCHIVE`}><article class="article"><a class="eyebrow" href="/institutions/">← Institutions & Spaces</a><h1>{item.data.name}</h1><div class="prose"><Content/></div><h2>Related exhibitions & events</h2><ol class="archive-list">{exhibitions.map(e=><li class="archive-entry"><time>{e.data.visitedOn.toISOString().slice(0,10)}</time><a href={`/exhibitions/${e.id}/`}>{e.data.title}</a></li>)}</ol></article></Base>
