---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const writing = await getCollection('entries', ({ data }) => !data.draft);
const photography = await getCollection('photographs', ({ data }) => !data.draft);

const items = [
  ...writing.map((item) => ({
    id: item.id,
    title: item.data.title,
    date: item.data.date,
    type: 'Text',
    url: `/writing/${item.id}/`,
  })),
  ...photography.map((item) => ({
    id: item.id,
    title: item.data.title,
    date: item.data.date,
    type: 'Image',
    url: `/photography/${item.id}/`,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf() || a.title.localeCompare(b.title));
---
<Base title="Index — Tow Deng">
  <section class="home-index" aria-labelledby="index-title">
    <div class="home-index-heading">
      <h1 id="index-title">Index</h1>
      <span>{String(items.length).padStart(2, '0')} entries · newest first</span>
    </div>

    <div class="home-index-labels" aria-hidden="true">
      <span>Date</span>
      <span>Title</span>
      <span>Type</span>
    </div>

    <ol class="home-index-list">
      {items.map((item) => (
        <li class="home-index-row">
          <time datetime={item.date.toISOString().slice(0, 10)}>{item.date.toISOString().slice(0, 10)}</time>
          <a href={item.url}>{item.title}<span aria-hidden="true"> ↗</span></a>
          <span class="home-index-type">{item.type}</span>
        </li>
      ))}
    </ol>

    {items.length === 0 && <p class="home-index-empty">No public entries yet.</p>}
  </section>
</Base>

<style>
  .home-index { padding-top: 40px; min-height: 50vh; }
  .home-index-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding-bottom: 35px; }
  .home-index-heading h1 { font-size: clamp(36px, 5vw, 68px); line-height: 1; font-weight: 400; letter-spacing: -.06em; margin: 0; }
  .home-index-heading > span { font-size: 11px; color: #777; }
  .home-index-labels, .home-index-row { display: grid; grid-template-columns: 115px minmax(0, 1fr) 95px; column-gap: 18px; }
  .home-index-labels { padding: 12px 0; border-top: 1px solid #222; color: #777; font-size: 11px; text-transform: uppercase; letter-spacing: .08em; }
  .home-index-list { list-style: none; margin: 0; padding: 0; }
  .home-index-row { align-items: baseline; padding: 18px 0; border-top: 1px solid #c5c4be; }
  .home-index-row:last-child { border-bottom: 1px solid #c5c4be; }
  .home-index-row time, .home-index-type { color: #777; font-size: 12px; font-variant-numeric: tabular-nums; }
  .home-index-row a { font-size: clamp(16px, 1.8vw, 22px); line-height: 1.4; letter-spacing: -.025em; }
  .home-index-row a span { font-size: .7em; opacity: 0; transition: opacity .15s ease; }
  .home-index-row a:hover span, .home-index-row a:focus-visible span { opacity: 1; }
  .home-index-empty { padding: 20px 0; color: #777; }
  @media (max-width: 600px) {
    .home-index { padding-top: 30px; }
    .home-index-heading { padding-bottom: 24px; }
    .home-index-labels, .home-index-row { grid-template-columns: 84px minmax(0, 1fr); column-gap: 12px; }
    .home-index-labels span:last-child, .home-index-type { display: none; }
    .home-index-row { padding: 15px 0; }
    .home-index-row time { font-size: 11px; }
  }
</style>
