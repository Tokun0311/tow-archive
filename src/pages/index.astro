---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const writing = await getCollection('entries', ({ data }) => !data.draft);
const photography = await getCollection('photographs', ({ data }) => !data.draft);
const items = [
  ...writing.map((item) => ({
    id: item.id,
    title: item.data.title,
    date: item.data.date,
    language: item.data.language.toLowerCase(),
    type: 'Writing',
    url: `/writing/${item.id}/`,
  })),
  ...photography.map((item) => ({
    id: item.id,
    title: item.data.title,
    date: item.data.date,
    language: item.data.language.toLowerCase(),
    type: 'Photography',
    url: `/photography/${item.id}/`,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf() || a.title.localeCompare(b.title));
---
<Base title="Lichuan Tow Deng">
  <section class="archive" aria-label="Archive entries">
    <div class="filters" role="group" aria-label="Filter and sort entries">
      <div class="filter-languages" aria-label="Language">
        <button type="button" data-language="all" aria-pressed="true">All</button>
        <button type="button" data-language="zh" aria-pressed="false">中文</button>
        <button type="button" data-language="ja" aria-pressed="false">日本語</button>
        <button type="button" data-language="en" aria-pressed="false">English</button>
      </div>
      <label class="sort-label">
        <span class="sr-only">Sort by date</span>
        <select id="date-sort" aria-label="Sort by date">
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
      </label>
    </div>
    <ol class="archive-list" id="archive-list">
      {items.map((item, index) => (
        <li class="archive-entry" data-date={item.date.toISOString()} data-language={item.language} data-original-index={index}>
          <time datetime={item.date.toISOString().slice(0, 10)}>{item.date.toISOString().slice(0, 10)}</time>
          <a href={item.url}>{item.title}</a>
          <span class="entry-type">{item.type}</span>
        </li>
      ))}
    </ol>
    <p class="empty-message" id="empty-message" hidden>No entries in this language yet.</p>
  </section>
</Base>
<script>
  const list = document.querySelector<HTMLUListElement>('#archive-list');
  const sort = document.querySelector<HTMLSelectElement>('#date-sort');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-language]'));
  const rows = Array.from(document.querySelectorAll<HTMLLIElement>('.archive-entry'));
  const empty = document.querySelector<HTMLElement>('#empty-message');
  let activeLanguage = 'all';

  function update() {
    const visible = rows.filter(row => activeLanguage === 'all' || row.dataset.language === activeLanguage);
    const sorted = [...visible].sort((a, b) => {
      const aTime = Date.parse(a.dataset.date || '');
      const bTime = Date.parse(b.dataset.date || '');
      return sort?.value === 'oldest' ? aTime - bTime : bTime - aTime;
    });
    rows.forEach(row => { row.hidden = !visible.includes(row); });
    sorted.forEach(row => list?.appendChild(row));
    empty?.toggleAttribute('hidden', visible.length > 0);
  }
  buttons.forEach(button => button.addEventListener('click', () => {
    activeLanguage = button.dataset.language || 'all';
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b === button)));
    update();
  }));
  sort?.addEventListener('change', update);
  update();
</script>
