---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('photographs',({data})=>!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}
const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={`${post.data.title} — TOW ARCHIVE`}><article class="article"><a href="/" class="eyebrow">← Home</a><h1>{post.data.title}</h1><div class="eyebrow">{post.data.date.toISOString().slice(0,10)} {post.data.location?`/ ${post.data.location}`:''}</div><p class="lead">{post.data.description}</p><div class="tags">{post.data.tags.map(t=><span class="tag">{t}</span>)}</div><div class="prose"><Content/></div><div class="photo-grid">{post.data.images.length>0?post.data.images.map((im,i)=><div><div class="photo-box"><img src={im.src} alt={im.alt} loading="lazy"/></div><p class="photo-caption">{String(i+1).padStart(2,'0')} / {im.alt}</p></div>):<div class="photo-box">Place photos in /public/images and add their paths to this series' Markdown frontmatter.</div>}</div><a href="/" class="eyebrow">← Back to archive</a></article></Base>
