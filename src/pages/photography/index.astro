---
import Base from '../../layouts/Base.astro';
import {getCollection} from 'astro:content';
const items=(await getCollection('photographs',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<Base title="Photography — Tow Deng"><div class="eyebrow" style="margin-top:42px">Collection / 02</div><h1 class="page-title">Photography.</h1><p class="intro">Visual field notes, sequences, and personal ways of looking. Organized as projects rather than an endless stream of images.</p><div class="photo-grid">{items.map(p=><a href={`/photography/${p.id}/`}><div class="photo-box">{p.data.images.length>0?<img src={p.data.images[0].src} alt={p.data.images[0].alt}/>:<span>IMAGE SERIES / ADD YOUR PHOTOGRAPHS</span>}</div><div class="photo-caption">{p.data.date.getFullYear()} / {p.data.title} ↗</div></a>)}</div></Base>
