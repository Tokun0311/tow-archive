---
import '../styles/global.css';
const { title = 'Tow Archive', description = 'Writing, photography and research by Lichuan Tow Deng.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="frame">
      <header class="mast">
        <a class="brand" href="/">Tow Archive</a>
        <nav aria-label="Main navigation"><a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a></nav>
      </header>
      <main><slot /></main>
    </div>
  </body>
</html>
